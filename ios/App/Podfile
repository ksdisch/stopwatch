require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '13.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorFirebaseAuthentication', :path => '../../node_modules/@capacitor-firebase/authentication'
  pod 'CapacitorFirebaseFirestore', :path => '../../node_modules/@capacitor-firebase/firestore'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorHaptics', :path => '../../node_modules/@capacitor/haptics'
  pod 'CapacitorLocalNotifications', :path => '../../node_modules/@capacitor/local-notifications'
  pod 'CapacitorNetwork', :path => '../../node_modules/@capacitor/network'
end

target 'App' do
  capacitor_pods
  # Google Sign-In SDK — separate entry because @capacitor-firebase/authentication's
  # /Google subspec is broken on path-based pods (the subspec selection drops the
  # parent's source_files from the build). Version matches what the plugin's
  # Google subspec would normally pull in.
  pod 'GoogleSignIn', '7.1.0'
end

post_install do |installer|
  assertDeploymentTarget(installer)

  # Manually wire what @capacitor-firebase/authentication's /Google subspec
  # would have done: set -DRGCFA_INCLUDE_GOOGLE so #if RGCFA_INCLUDE_GOOGLE code
  # paths activate, link GoogleSignIn as a target dependency so build order is
  # correct, and add GoogleSignIn's framework directory to FRAMEWORK_SEARCH_PATHS
  # so `import GoogleSignIn` resolves at Swift compile time.
  google_signin_target = installer.pods_project.targets.find { |t| t.name == 'GoogleSignIn' }

  installer.pods_project.targets.each do |target|
    next unless target.name == 'CapacitorFirebaseAuthentication'
    target.build_configurations.each do |config|
      # 1. Activate Google code paths.
      existing_flags = config.build_settings['OTHER_SWIFT_FLAGS'] || '$(inherited)'
      unless existing_flags.to_s.include?('-DRGCFA_INCLUDE_GOOGLE')
        config.build_settings['OTHER_SWIFT_FLAGS'] = "#{existing_flags} -DRGCFA_INCLUDE_GOOGLE"
      end
      # 2. Make GoogleSignIn's framework visible to Swift's module loader.
      existing_paths = config.build_settings['FRAMEWORK_SEARCH_PATHS'] || '$(inherited)'
      gs_path = '"${PODS_CONFIGURATION_BUILD_DIR}/GoogleSignIn"'
      unless existing_paths.to_s.include?(gs_path)
        config.build_settings['FRAMEWORK_SEARCH_PATHS'] = "#{existing_paths} #{gs_path}"
      end
    end
    # 3. Build-order dependency so GoogleSignIn.framework exists before the
    #    plugin's compile step references it.
    if google_signin_target && !target.dependencies.any? { |d| d.target == google_signin_target }
      target.add_dependency(google_signin_target)
    end
  end
end
