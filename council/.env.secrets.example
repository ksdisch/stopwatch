# life-os-council — environment template
#
# Copy this file to `.env.secrets` and fill in real values:
#
#     cd council && cp .env.secrets.example .env.secrets
#
# `run-synthesis.sh` sources `council/.env.secrets` before launching
# synthesize.mjs, so these variables are inherited by the Node process and the
# notify_failure curl calls. `council/.env.secrets` is gitignored (NEVER commit
# it); this `.env.secrets.example` is the committed, value-free reference.
#
# `export` matters: run-synthesis.sh runs node as a *child* process, which only
# inherits exported variables.

# ── REQUIRED — Firebase Admin credentials ───────────────────────────────────
# Absolute path to the Firebase service-account key JSON. firebase-admin's
# applicationDefault() reads this env var to authenticate. The Admin SDK
# bypasses firestore.rules, so the council writes the synthesis record freely.
# The key file itself is gitignored (matches service-account.json /
# *-firebase-adminsdk-*.json in .gitignore) — keep it OUTSIDE the repo or under
# a gitignored path. NEVER commit the key.
export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/life-os/tempo-sync-adminsdk.json"

# ── REQUIRED — write target ─────────────────────────────────────────────────
# The Firebase Auth uid to write under: users/{TEMPO_UID}/synthesis/home.
export TEMPO_UID="REPLACE_WITH_FIREBASE_AUTH_UID"

# ── OPTIONAL — Slack failure alert ──────────────────────────────────────────
# A Slack Incoming Webhook URL. When set, run-synthesis.sh's notify_failure
# POSTs {"text": "..."} here on ANY failure (preflight or run). The target
# channel is baked into the URL at workspace-configuration time. Unset → the
# alert silently no-ops and the run still exits with the correct code.
# (left blank in the template — a webhook-shaped placeholder trips GitHub push
#  protection. Set it to your real Incoming Webhook in council/.env.secrets,
#  form: hooks.slack.com/services/<workspace>/<channel>/<token>)
export SLACK_WEBHOOK_URL=""

# ── OPTIONAL — Twilio SMS failure alert ─────────────────────────────────────
# Sibling of Slack. ALL FOUR must be set for the SMS to send; any missing one
# skips the send. Numbers are E.164 (e.g. +13135551234). Twilio is optional —
# Slack alone is enough for the Phase-0 failure-alert design.
export TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export TWILIO_AUTH_TOKEN="your_twilio_auth_token"
export TWILIO_FROM_NUMBER="+1XXXXXXXXXX"
export TWILIO_TO_NUMBER="+1XXXXXXXXXX"
