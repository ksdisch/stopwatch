# council/alerts.env.example — push-alert credentials for the council runner.
#
# WHY A SEPARATE FILE: run-synthesis.sh sources this file BEFORE it perms-guards
# (and, on a bad perms bit, refuses to source) council/.env.secrets. So the
# failure that most needs an alert — an unreadable / wrong-perms .env.secrets —
# can still reach you, because these creds do NOT live inside the guarded file.
# The 2026-06-14..2026-07-08 outage stayed silent for ~3.5 weeks precisely
# because the alert creds were trapped inside the file the guard was refusing to
# read. This file breaks that chicken-and-egg.
#
# SETUP (once per machine):
#   mkdir -p ~/.config/life-os
#   cp council/alerts.env.example ~/.config/life-os/alerts.env
#   # paste your real values below, then lock it down:
#   chmod 600 ~/.config/life-os/alerts.env
#
# The runner looks at ~/.config/life-os/alerts.env by default; override with the
# ALERTS_ENV env var. Everything here is OPTIONAL and best-effort: an empty or
# missing value just means that channel no-ops, and the run still exits with the
# correct code. If you already keep these in council/.env.secrets, copy the SAME
# values here so an alert survives the .env.secrets perms guard.

# ── Slack incoming webhook (recommended — Slack alone is enough) ─────────────
# https://api.slack.com/messaging/webhooks
export SLACK_WEBHOOK_URL=""

# ── Twilio SMS (optional — all four are required, or leave the block unset) ──
# export TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# export TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# export TWILIO_FROM_NUMBER="+1XXXXXXXXXX"
# export TWILIO_TO_NUMBER="+1XXXXXXXXXX"
