{
  "name": "tempo",
  "version": "1.0.0",
  "private": true,
  "description": "Tempo — cross-platform stopwatch / timer / wellness PWA + iOS shell",
  "scripts": {
    "sync-www": "node scripts/sync-www.mjs",
    "ios:copy": "npm run sync-www && cap copy ios",
    "ios:open": "npm run ios:copy && cap open ios",
    "ios:sync": "npm run sync-www && cap sync ios",
    "test": "node scripts/run-tests.mjs",
    "test:serve": "python3 -m http.server 8765",
    "test:rules": "npx --yes firebase-tools@13 emulators:exec --only firestore --project=demo-tempo 'node --test tests/rules/firestore-rules.test.mjs'",
    "check:assets": "node scripts/check-asset-integrity.mjs",
    "check:sw-bump": "node scripts/check-sw-bump.mjs",
    "check:load-order": "node scripts/check-load-order.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^6.3.1",
    "@capacitor-firebase/firestore": "^6.3.1",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "firebase": "^11.10.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "playwright": "^1.49.0"
  }
}
