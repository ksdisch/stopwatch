<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ksdisch.life-os.synthesis.weekly</string>

    <!-- WEEKLY RECAP. Fire the council synthesis run at 18:00 local on Sunday
         (Weekday 0). launchd StartCalendarInterval fires at the system's local
         wall-clock time and re-evaluates across DST, so this stays 18:00 *local*
         year-round. If the Mac is asleep at the trigger, launchd runs the job at
         next wake. Sunday evening means the weekly Balance recap (with 1-3
         cross-pillar moves) is fresh in Firestore for the week ahead. The daily
         glance is the separate com.ksdisch.life-os.synthesis plist. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- SYNTH_MODE=weekly → synthesize.mjs runs the recap and emits the top
         1-3 cross-pillar nudges. (This is also synthesize.mjs's default, but the
         plist pins it explicitly so the job's intent is unambiguous.) -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>SYNTH_MODE</key>
        <string>weekly</string>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/kyledisch/Projects/stopwatch/council/run-synthesis.sh</string>
    </array>

    <!-- run-synthesis.sh is CWD-independent (it resolves REPO from its own
         path), but set WorkingDirectory for cleanliness. -->
    <key>WorkingDirectory</key>
    <string>/Users/kyledisch/Projects/stopwatch</string>

    <!-- Only fire on the calendar trigger - never at load/login/boot. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Wrapper-level stdout/stderr (the "✔ council run succeeded" /
         "COUNCIL FAILED" lines run-synthesis.sh echoes to >&2). The council's
         own per-run output still goes to council/logs/nightly/<UTC-date>.log.
         Run `mkdir -p council/logs/launchd` before loading - launchd will NOT
         create these directories and the job fails to launch without them.
         (Shared with the daily plist; both write here.) -->
    <key>StandardOutPath</key>
    <string>/Users/kyledisch/Projects/stopwatch/council/logs/launchd/weekly-out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kyledisch/Projects/stopwatch/council/logs/launchd/weekly-err.log</string>
</dict>
</plist>
